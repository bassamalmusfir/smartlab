# Copy this file to .env and fill it in. Never commit .env.

# Which AI analyzes the reports:
#   ollama - MedGemma running on this machine through Ollama. Free, no key needed.
#   claude - the Anthropic API. Needs ANTHROPIC_API_KEY.
AI_PROVIDER=ollama

# Ollama settings. Install Ollama, then run: ollama pull medgemma1.5:4b-it-q8_0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=medgemma1.5:4b-it-q8_0

# Claude settings, used only when AI_PROVIDER=claude.
ANTHROPIC_API_KEY=your-api-key-here
CLAUDE_MODEL=claude-opus-5-5

PORT=3000

# Comma-separated origins allowed to call this server (the Flutter web dev server).
ALLOWED_ORIGINS=http://localhost:8765
