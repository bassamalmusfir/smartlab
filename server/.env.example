# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=your-api-key-here

# Which Claude model analyzes the reports. Change this to switch models.
CLAUDE_MODEL=claude-opus-5-5

PORT=3000

# Comma-separated origins allowed to call this server (the Flutter web dev server).
ALLOWED_ORIGINS=http://localhost:8765
