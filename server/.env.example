# Copy this file to .env and fill it in. Never commit .env.

# MedGemma runs on this machine through Ollama. Free, no key needed.
# Install Ollama, then run: ollama pull medgemma1.5:4b-it-q8_0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=medgemma1.5:4b-it-q8_0

PORT=3000

# Comma-separated origins allowed to call this server (the Flutter web dev server).
ALLOWED_ORIGINS=http://localhost:8765
